# MONGO CONFIGURATION
LOCAL_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/fashion-fever?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/fashion-fever?retryWrites=true&w=majority

# SERVER CONFIGURATION
PORT=9000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# LIVE API & UPLOAD CONFIGURATION
SERVER_BASE_URL=https://fashionfever.in/fashion_fever_api/api/v1
UPLOAD_DIR=/var/www/uploads
STORAGE_USED=local

# CLOUDINARY CONFIGURATION (OPTIONAL IF STORAGE_USED=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EMAIL & THIRD-PARTY SERVICES
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password
SHIPROCKET_USER_PASSWORD=your_shiprocket_password
SHIPROCKET_USER_EMAIL=your_shiprocket_email
SHIPROCKET_USER_URL=https://apiv2.shiprocket.in/v1/external
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
